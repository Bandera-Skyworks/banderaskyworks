  tractor:
    '<circle cx="7" cy="17" r="3"/><circle cx="18" cy="18" r="2"/><path d="M10 17H4V9h6l2-4h3l1 5h3M10 9v8"/>',
  home: '<path d="M3 11 12 3l9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
  plane:
    '<path d="M17.8 19.2 16 11l3.5-3.5a2.1 2.1 0 0 0-3-3L13 8 4.8 6.2a.5.5 0 0 0-.5.8L8 11l-2 2-2.5-.5L3 13l3 2 2 3 .5-.5L8 15l2-2 3.7 3.7a.5.5 0 0 0 .8-.5Z"/>',
