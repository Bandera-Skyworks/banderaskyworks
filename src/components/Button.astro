---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'outline';
  icon?: string;
  class?: string;
  type?: 'button' | 'submit';
  id?: string;
}
const { href, variant = 'primary', icon, class: className = '', type = 'button', id } = Astro.props;

const cls = `${variant === 'primary' ? 'btn-primary' : 'btn-outline'} ${className}`.trim();
const Tag = href ? 'a' : 'button';
---

<Tag class={cls} id={id} {...href ? { href } : { type }}>
  {icon && <Icon name={icon} class="h-5 w-5" />}
  <slot />
</Tag>
