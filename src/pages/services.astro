---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import { services, industries } from '../lib/site';
---

<BaseLayout
  title="Drone Inspection Services | Powerline, Solar, Wind Turbine | Bandera Skyworks"
  description="Professional drone inspection services: powerline inspection, substation monitoring, solar farm analysis, wind turbine inspection, and emergency response. Serving Texas Hill Country with FAA certified pilots."
  keywords="powerline inspection, substation inspection, solar farm inspection, wind turbine inspection, drone services texas, aerial inspection, infrastructure monitoring, emergency response"
  canonical="/services.html"
  ogImage="https://banderaskyworks.com/assets/images/pl-inspection.jpg"
>
  <PageHeader title="Our Services" crumb="Services" />

  <section class="mx-auto max-w-(--breakpoint-xl) px-4 py-16 md:px-6 md:py-20">
    <p class="text-theme-xl mx-auto max-w-3xl text-center text-gray-600 dark:text-gray-400">
      Bandera Skyworks offers comprehensive drone inspection services designed to meet the unique
      needs of Texas utilities, energy companies, and commercial enterprises — delivering actionable
      insights that enhance safety, reduce costs, and improve operational efficiency.
    </p>

    <div class="mt-14 space-y-8">
      {
        services.map((s) => (
          <Card class="overflow-hidden">
            <div class="flex items-center justify-between gap-4 border-b border-gray-100 px-6 py-5 dark:border-gray-800">
              <div>
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white/90">{s.title}</h2>
                <p class="text-brand-500 dark:text-brand-400 mt-0.5 text-sm font-medium">
                  {s.pricing}
                </p>
              </div>
              <div class="bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-400 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl">
                <Icon name={s.icon} class="h-6 w-6" />
              </div>
            </div>
            <div class="p-6">
              <p class="text-gray-600 dark:text-gray-400">{s.description}</p>

              <div class="mt-8 grid gap-8 lg:grid-cols-2">
                <div>
                  <h3 class="text-sm font-semibold tracking-wide text-gray-900 uppercase dark:text-white/90">
                    Key Features
                  </h3>
                  <ul class="mt-4 space-y-2.5">
                    {s.features.map((f) => (
                      <li class="flex items-start gap-2.5 text-sm text-gray-600 dark:text-gray-400">
                        <Icon name="check" class="text-success-500 mt-0.5 h-4 w-4 shrink-0" />
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="text-sm font-semibold tracking-wide text-gray-900 uppercase dark:text-white/90">
                    Benefits
                  </h3>
                  <div class="mt-4 grid gap-3 sm:grid-cols-2">
                    {s.benefits.map((b) => (
                      <div class="rounded-xl border border-gray-100 bg-gray-50 p-4 dark:border-gray-800 dark:bg-white/[0.02]">
                        <div class="text-sm font-semibold text-gray-900 dark:text-white/90">
                          {b.title}
                        </div>
                        <div class="mt-1 text-xs text-gray-500 dark:text-gray-400">{b.body}</div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </Card>
        ))
      }
    </div>

    <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-gray-500 dark:text-gray-400">
      Starting rates reflect typical projects in the Texas Hill Country. Final pricing depends on
      site size, sensor requirements, and reporting depth —
      <a href="/contact.html" class="text-brand-500 dark:text-brand-400 font-medium hover:underline"
        >contact us</a
      > for a custom quote.
    </p>
  </section>

  <!-- Industries -->
  <section class="border-y border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
    <div class="mx-auto max-w-(--breakpoint-xl) px-4 py-20 md:px-6">
      <h2
        class="text-title-sm text-center font-semibold tracking-tight text-gray-900 dark:text-white/90"
      >
        Industries We Serve
      </h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          industries.map((i) => (
            <Card hover class="p-6">
              <div class="bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-400 flex h-12 w-12 items-center justify-center rounded-xl">
                <Icon name={i.icon} class="h-6 w-6" />
              </div>
              <h3 class="mt-5 font-semibold text-gray-900 dark:text-white/90">{i.title}</h3>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{i.body}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-(--breakpoint-xl) px-4 py-20 md:px-6">
    <div
      class="bg-brand-500 shadow-theme-lg overflow-hidden rounded-2xl px-6 py-14 text-center md:px-12"
    >
      <h2 class="text-title-sm mx-auto max-w-2xl font-semibold tracking-tight text-white">
        Ready to get started?
      </h2>
      <p class="text-brand-100 mx-auto mt-4 max-w-xl">
        Contact us today for a free consultation and custom quote for your project.
      </p>
      <a
        href="/contact.html"
        class="text-brand-600 shadow-theme-xs hover:bg-brand-25 mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-white px-5 py-3.5 text-sm font-medium transition-colors"
      >
        Request Quote
      </a>
    </div>
  </section>
</BaseLayout>
